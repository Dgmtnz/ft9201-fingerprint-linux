From b6b2ba7094092f305561661471f06e0467acd424 Mon Sep 17 00:00:00 2001
From: dgmtnz <dgmtnz.2019@gmail.com>
Date: Fri, 21 Aug 2026 00:55:02 +0200
Subject: [PATCH 4/6] focaltech_moh: address review, add 2808:9348

Applies the outstanding review suggestions on !572:

  - FT9201_VID becomes FOCALTECH_VID, since 0x2808 identifies the
    vendor rather than the chip, and drops FT9201_PID now that the
    id_table lists more than one product id (notes #3578626, #3578628).
  - Adds 2808:9348 to the id_table (note #3578623), reported working by
    @Vineyo in note #3578095 and confirmed by @Kwaadpepper in note
    #3596398 on Pop!_OS.

Also moves 9348 out of the unsupported-device list in
fprint-list-udev-hwdb.c and into the focaltech_moh section of
autosuspend.hwdb, which is what the original hwdb commit did for 9338.
---
 data/autosuspend.hwdb                           | 2 +-
 libfprint/drivers/focaltech_moh/focaltech_moh.c | 3 ++-
 libfprint/drivers/focaltech_moh/focaltech_moh.h | 3 +--
 libfprint/fprint-list-udev-hwdb.c               | 1 -
 4 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/data/autosuspend.hwdb b/data/autosuspend.hwdb
index 67bcfe5..9107577 100644
--- a/data/autosuspend.hwdb
+++ b/data/autosuspend.hwdb
@@ -204,6 +204,7 @@ usb:v2808p6553*
 
 # Supported by libfprint driver focaltech_moh
 usb:v2808p9338*
+usb:v2808p9348*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
 
@@ -545,7 +546,6 @@ usb:v27C6p5F10*
 usb:v27C6p5F91*
 usb:v2808p06FC*
 usb:v2808p6652*
-usb:v2808p9348*
 usb:v2808p93A9*
 usb:v2808pA553*
 usb:v2808pA573*
diff --git a/libfprint/drivers/focaltech_moh/focaltech_moh.c b/libfprint/drivers/focaltech_moh/focaltech_moh.c
index ffd63ff..86ecc58 100644
--- a/libfprint/drivers/focaltech_moh/focaltech_moh.c
+++ b/libfprint/drivers/focaltech_moh/focaltech_moh.c
@@ -44,7 +44,8 @@ G_DEFINE_TYPE (FpiDeviceFocaltechMoh, fpi_device_focaltech_moh,
                FP_TYPE_DEVICE)
 
 static const FpIdEntry id_table[] = {
-  { .vid = FT9201_VID, .pid = FT9201_PID },
+  { .vid = FOCALTECH_VID, .pid = 0x9338 },
+  { .vid = FOCALTECH_VID, .pid = 0x9348 },
   { .vid = 0, .pid = 0 },
 };
 
diff --git a/libfprint/drivers/focaltech_moh/focaltech_moh.h b/libfprint/drivers/focaltech_moh/focaltech_moh.h
index 3dcd20a..b826348 100644
--- a/libfprint/drivers/focaltech_moh/focaltech_moh.h
+++ b/libfprint/drivers/focaltech_moh/focaltech_moh.h
@@ -26,8 +26,7 @@
 G_DECLARE_FINAL_TYPE (FpiDeviceFocaltechMoh, fpi_device_focaltech_moh, FPI,
                       DEVICE_FOCALTECH_MOH, FpDevice)
 
-#define FT9201_VID 0x2808
-#define FT9201_PID 0x9338
+#define FOCALTECH_VID 0x2808
 
 #define FT9201_EP_IN 0x83   /* Bulk IN  (EP3, 32B max packet) */
 
diff --git a/libfprint/fprint-list-udev-hwdb.c b/libfprint/fprint-list-udev-hwdb.c
index 90a43be..4907480 100644
--- a/libfprint/fprint-list-udev-hwdb.c
+++ b/libfprint/fprint-list-udev-hwdb.c
@@ -188,7 +188,6 @@ static const FpIdEntry allowlist_id_table[] = {
   { .vid = 0x27c6, .pid = 0x5f91 },
   { .vid = 0x2808, .pid = 0x06fc },
   { .vid = 0x2808, .pid = 0x6652 },
-  { .vid = 0x2808, .pid = 0x9348 },
   { .vid = 0x2808, .pid = 0x93a9 },
   { .vid = 0x2808, .pid = 0xa553 },
   { .vid = 0x2808, .pid = 0xa573 },
