From 8434f89184ea285b5b206c0a46b68bcac708d584 Mon Sep 17 00:00:00 2001
From: dgmtnz <dgmtnz.2019@gmail.com>
Date: Fri, 21 Aug 2026 00:52:59 +0200
Subject: [PATCH 1/4] focaltech_moh: retune matcher parameters against measured
 data

The matcher never converged on real hardware: genuine and impostor
scores overlapped, so no threshold was safe. In note #3596398
@Kwaadpepper posts a *successful* verify clearing the threshold by 0.02
with four of five templates under 0.11, which is the same picture.

Measured on a 25 genuine / 24 impostor capture set from an Alurin
ALU-BAR-R75825 (2808:9338), three parameters were off:

  FT9201_SEARCH_RADIUS      3  -> 16
  FT9201_NUM_ENROLL_STAGES  5  -> 15
  FT9201_NCC_THRESHOLD    0.30 -> 0.55

The search radius is the main one. Real finger placement on a 3x4 mm
sensor varies by ~16 px between presses, so a +-3 px search never finds
the alignment. Sweeping it at 15 templates:

  radius  3: EER 8.83%   radius 12: EER 4.26%
  radius  8: EER 4.23%   radius 16: EER 0.07%
  radius 20: EER 0.15% (no gain, 1.5x the cost)

Stage count matters nearly as much, since each template covers only a
fraction of the finger. At radius 16: 5 templates give EER 7.4%, 10
give 1.6%, 15 give 0.07%.

The threshold is set at 0.55 rather than the 0.50 that minimises FRR:
the highest impostor score observed was 0.468 and the 1st percentile of
genuine scores 0.496, and with impostors drawn from only three fingers
that FAR estimate is optimistic. 0.55 trades a 4.5% false reject rate
for margin.

Live verification after the change: 8/8 genuine accepted (0.874-0.951),
0/10 impostor accepted (0.111-0.446).

Templates move to the heap because 15 * 5120 bytes overflows the 64K
GObject instance size limit, which fails the build at metainfo
generation with a g_type_register_static_simple assertion.
---
 libfprint/drivers/focaltech_moh/focaltech_moh.c |  6 ++++--
 libfprint/drivers/focaltech_moh/focaltech_moh.h | 11 +++++++----
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/libfprint/drivers/focaltech_moh/focaltech_moh.c b/libfprint/drivers/focaltech_moh/focaltech_moh.c
index 3088b5e..4c705d1 100644
--- a/libfprint/drivers/focaltech_moh/focaltech_moh.c
+++ b/libfprint/drivers/focaltech_moh/focaltech_moh.c
@@ -412,7 +412,7 @@ enroll_ssm_handler (FpiSsm *ssm, FpDevice *dev)
           }
 
         ft9201_preprocess (self->image_buf, preprocessed);
-        memcpy (self->enroll_images[self->enroll_stage], preprocessed,
+        memcpy (self->enroll_images + self->enroll_stage * FT9201_RAW_SIZE, preprocessed,
                 FT9201_RAW_SIZE);
 
         self->enroll_stage++;
@@ -442,7 +442,7 @@ enroll_ssm_handler (FpiSsm *ssm, FpDevice *dev)
           {
             GVariant *img = g_variant_new_fixed_array (
               G_VARIANT_TYPE_BYTE,
-              self->enroll_images[i], FT9201_RAW_SIZE, 1);
+              self->enroll_images + i * FT9201_RAW_SIZE, FT9201_RAW_SIZE, 1);
 
             g_variant_builder_add (&builder, "(@ay)", img);
           }
@@ -627,6 +627,7 @@ dev_open (FpDevice *dev)
     }
 
   self->image_buf = g_malloc0 (FT9201_RAW_SIZE);
+  self->enroll_images = g_malloc0 (FT9201_NUM_ENROLL_STAGES * FT9201_RAW_SIZE);
   self->warmup_done = FALSE;
 
   fpi_device_open_complete (dev, NULL);
@@ -641,6 +642,7 @@ dev_close (FpDevice *dev)
   G_DEBUG_HERE ();
 
   g_clear_pointer (&self->image_buf, g_free);
+  g_clear_pointer (&self->enroll_images, g_free);
 
   g_usb_device_release_interface (fpi_device_get_usb_device (dev),
                                   0, 0, &error);
diff --git a/libfprint/drivers/focaltech_moh/focaltech_moh.h b/libfprint/drivers/focaltech_moh/focaltech_moh.h
index 3116154..278eb48 100644
--- a/libfprint/drivers/focaltech_moh/focaltech_moh.h
+++ b/libfprint/drivers/focaltech_moh/focaltech_moh.h
@@ -40,9 +40,9 @@ G_DECLARE_FINAL_TYPE (FpiDeviceFocaltechMoh, fpi_device_focaltech_moh, FPI,
 #define FT9201_POLL_INTERVAL 30   /* ms between finger detection polls */
 
 /* Enrollment and matching */
-#define FT9201_NUM_ENROLL_STAGES  5
-#define FT9201_NCC_THRESHOLD      0.30
-#define FT9201_SEARCH_RADIUS      3     /* pixels, each direction */
+#define FT9201_NUM_ENROLL_STAGES  15
+#define FT9201_NCC_THRESHOLD      0.55
+#define FT9201_SEARCH_RADIUS      16    /* pixels, each direction */
 #define FT9201_LOCAL_MEAN_WINDOW  7     /* 7x7 window for high-pass */
 #define FT9201_MIN_UNIQUE_VALUES  50    /* minimum unique pixel values for quality */
 
@@ -122,7 +122,10 @@ struct _FpiDeviceFocaltechMoh
 
   /* Enroll state */
   int           enroll_stage;
-  guint8        enroll_images[FT9201_NUM_ENROLL_STAGES][FT9201_RAW_SIZE];
+  /* FT9201_NUM_ENROLL_STAGES * FT9201_RAW_SIZE bytes, allocated in dev_open().
+   * Kept off the instance struct: GObject caps instance size at 64K and the
+   * template set alone exceeds that once the stage count is raised. */
+  guint8       *enroll_images;
 
   /* Top-level SSM */
   FpiSsm       *task_ssm;
-- 
2.55.0

