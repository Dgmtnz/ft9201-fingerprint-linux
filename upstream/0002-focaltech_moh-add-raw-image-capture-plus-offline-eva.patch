From b9d9d007ddd50d5921bb071e317e93e30141a971 Mon Sep 17 00:00:00 2001
From: dgmtnz <dgmtnz.2019@gmail.com>
Date: Thu, 20 Aug 2026 01:17:03 +0200
Subject: [PATCH 2/3] focaltech_moh: add raw image capture, plus offline
 evaluation tools

Implements dev_class->capture, handing out the raw sensor frame rather
than the preprocessed one. Without this there is no way to evaluate
preprocessing or matching offline, and every experiment costs another
round of finger presses.

Two throwaway tools that back the retuning in the previous commit:

  fp-collect   opens the device once and captures N frames in a row,
               which is what makes gathering a dataset practical.
  nbis-bench   runs libfprint's own NBIS pipeline over raw frames and
               prints minutiae counts and the bozorth3 score matrix.

nbis-bench is what ruled out the FpImageDevice route for this sensor:
64x80 px yields 2-4 minutiae per image where bozorth3 needs ~12, so
every score in the matrix is 0. That holds across ppmm from 8 to 40 and
both ridge polarities, so it is an area limit, not a tuning problem.

Also gates libfprint's thermal cutoff behind FT9201_NO_THERMAL_LIMIT
for dataset collection only. The temperature model counts time spent
waiting for a finger as active time, so bulk capture trips the overheat
guard on a sensor that is sitting idle.
---
 libfprint/fp-collect.c |  90 +++++++++++++++++++++++++
 libfprint/meson.build  |  13 ++++
 libfprint/nbis-bench.c | 148 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 251 insertions(+)
 create mode 100644 libfprint/fp-collect.c
 create mode 100644 libfprint/nbis-bench.c

diff --git a/libfprint/fp-collect.c b/libfprint/fp-collect.c
new file mode 100644
index 0000000..cd4669a
--- /dev/null
+++ b/libfprint/fp-collect.c
@@ -0,0 +1,90 @@
+/* Recolector de dataset para el FocalTech FT9201.
+ *
+ * Abre el dispositivo una vez y captura N imagenes crudas seguidas,
+ * guardandolas como <prefijo>NNN.raw (5120 bytes, 64x80, 8bpp).
+ *
+ * Uso: fp-collect <n_capturas> <prefijo_salida>
+ */
+#include <libfprint/fprint.h>
+#include <glib.h>
+#include <stdio.h>
+
+int
+main (int argc, char **argv)
+{
+  g_autoptr(FpContext) ctx = NULL;
+  g_autoptr(GError) error = NULL;
+  GPtrArray *devices;
+  FpDevice *dev = NULL;
+  int want, done = 0, failed = 0, i;
+  const char *prefix;
+
+  if (argc < 3)
+    {
+      g_printerr ("uso: %s <n_capturas> <prefijo>\n", argv[0]);
+      return 1;
+    }
+  want = atoi (argv[1]);
+  prefix = argv[2];
+
+  ctx = fp_context_new ();
+  devices = fp_context_get_devices (ctx);
+  if (!devices || devices->len == 0)
+    {
+      g_printerr ("no se ha encontrado ningun lector\n");
+      return 1;
+    }
+  dev = g_ptr_array_index (devices, 0);
+  g_print ("dispositivo: %s\n", fp_device_get_name (dev));
+
+  if (!fp_device_has_feature (dev, FP_DEVICE_FEATURE_CAPTURE))
+    {
+      g_printerr ("ERROR: este dispositivo no declara soporte de captura\n");
+      return 1;
+    }
+
+  if (!fp_device_open_sync (dev, NULL, &error))
+    {
+      g_printerr ("no puedo abrir: %s\n", error->message);
+      return 1;
+    }
+
+  g_print ("\nVoy a capturar %d imagenes.\n", want);
+  g_print ("Pon y levanta el dedo repetidamente, variando un poco la posicion.\n\n");
+
+  for (i = 0; done < want && failed < want * 3; i++)
+    {
+      g_autoptr(GError) cerr = NULL;
+      g_autoptr(FpImage) img = fp_device_capture_sync (dev, TRUE, NULL, &cerr);
+      const guchar *data;
+      gsize len = 0;
+      char fn[512];
+      FILE *f;
+
+      if (!img)
+        {
+          failed++;
+          g_print ("  [%2d] fallo: %s\n", i, cerr ? cerr->message : "?");
+          continue;
+        }
+      data = fp_image_get_data (img, &len);
+      g_snprintf (fn, sizeof (fn), "%s%03d.raw", prefix, done);
+      f = fopen (fn, "wb");
+      if (f)
+        {
+          fwrite (data, 1, len, f);
+          fclose (f);
+          done++;
+          g_print ("  [%2d] guardada %s (%zu bytes)\n", i, fn, len);
+        }
+      else
+        {
+          g_print ("  [%2d] no puedo escribir %s\n", i, fn);
+          failed++;
+        }
+    }
+
+  g_print ("\n%d capturas guardadas (%d fallos)\n", done, failed);
+  fp_device_close_sync (dev, NULL, NULL);
+  return 0;
+}
diff --git a/libfprint/meson.build b/libfprint/meson.build
index 9acf14b..fa8063d 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -321,6 +321,19 @@ libfprint_private_dep = declare_dependency(
     ]
 )
 
+fp_collect = executable('fp-collect',
+    'fp-collect.c',
+    dependencies: libfprint_private_dep,
+    link_with: libfprint_drivers,
+    install: false)
+
+nbis_bench = executable('nbis-bench',
+    'nbis-bench.c',
+    c_args: [ '-Wno-error=redundant-decls', '-Wno-redundant-decls' ],
+    dependencies: libfprint_private_dep,
+    link_with: libfprint_drivers,
+    install: false)
+
 udev_hwdb = executable('fprint-list-udev-hwdb',
     'fprint-list-udev-hwdb.c',
     dependencies: libfprint_private_dep,
diff --git a/libfprint/nbis-bench.c b/libfprint/nbis-bench.c
new file mode 100644
index 0000000..d977644
--- /dev/null
+++ b/libfprint/nbis-bench.c
@@ -0,0 +1,148 @@
+/* Banco de pruebas: mide si el pipeline NBIS (mindtct + bozorth3) es viable
+ * con las imagenes de 64x80 del sensor FocalTech FT9201.
+ *
+ * Uso: nbis-bench <ppmm> fichero1.raw fichero2.raw ...
+ * Cada .raw son 5120 bytes (64x80, 8bpp). Imprime el numero de minucias por
+ * imagen y la matriz completa de scores bozorth3.
+ */
+#include "fpi-image.h"
+#include "fp-image.h"
+#include "nbis/include/bozorth.h"
+#include "nbis/include/lfs.h"
+#include <glib.h>
+#include <stdio.h>
+#include <string.h>
+
+#define W 64
+#define H 80
+#define SZ (W * H)
+#define MAXF 64
+
+
+/* Copia de minutiae_to_xyt() de fpi-print.c (alli es static). */
+static void
+minutiae_to_xyt_local (struct fp_minutiae *minutiae, int bw, int bh,
+                       struct xyt_struct *xyt)
+{
+  int i;
+  struct minutiae_struct c[MAX_FILE_MINUTIAE];
+  int nmin = MIN (minutiae->num, MAX_BOZORTH_MINUTIAE);
+
+  for (i = 0; i < nmin; i++)
+    {
+      struct fp_minutia *m = minutiae->list[i];
+      lfs2nist_minutia_XYT (&c[i].col[0], &c[i].col[1], &c[i].col[2], m, bw, bh);
+      c[i].col[3] = sround (m->reliability * 100.0);
+      if (c[i].col[2] > 180)
+        c[i].col[2] -= 360;
+    }
+  qsort ((void *) &c, (size_t) nmin, sizeof (struct minutiae_struct), sort_x_y);
+  for (i = 0; i < nmin; i++)
+    {
+      xyt->xcol[i] = c[i].col[0];
+      xyt->ycol[i] = c[i].col[1];
+      xyt->thetacol[i] = c[i].col[2];
+    }
+  xyt->nrows = nmin;
+}
+
+typedef struct { char name[256]; int nmin; struct xyt_struct xyt; } Entry;
+
+static GMainLoop *loop;
+static gboolean   det_ok;
+
+static void
+on_detected (GObject *src, GAsyncResult *res, gpointer user)
+{
+  GError *err = NULL;
+  det_ok = fp_image_detect_minutiae_finish (FP_IMAGE (src), res, &err);
+  if (!det_ok)
+    {
+      g_printerr ("  (deteccion fallida: %s)\n", err ? err->message : "?");
+      g_clear_error (&err);
+    }
+  g_main_loop_quit (loop);
+}
+
+int
+main (int argc, char **argv)
+{
+  Entry ents[MAXF];
+  int n = 0, i, j;
+  double ppmm;
+
+  if (argc < 3)
+    {
+      g_printerr ("uso: %s <ppmm> f1.raw [f2.raw ...]\n", argv[0]);
+      return 1;
+    }
+  ppmm = g_ascii_strtod (argv[1], NULL);
+  loop = g_main_loop_new (NULL, FALSE);
+
+  g_print ("ppmm = %.2f  (sensor %dx%d = %.1f x %.1f mm)\n\n",
+           ppmm, W, H, W / ppmm, H / ppmm);
+  g_print ("=== MINUCIAS DETECTADAS POR IMAGEN ===\n");
+
+  for (i = 2; i < argc && n < MAXF; i++)
+    {
+      guint8 buf[SZ];
+      FILE *f = fopen (argv[i], "rb");
+      FpImage *img;
+      GPtrArray *min;
+
+      if (!f || fread (buf, 1, SZ, f) != SZ)
+        {
+          g_printerr ("no puedo leer %s\n", argv[i]);
+          if (f) fclose (f);
+          continue;
+        }
+      fclose (f);
+
+      img = fp_image_new (W, H);
+      img->ppmm = ppmm;
+      memcpy (img->data, buf, SZ);
+
+      det_ok = FALSE;
+      fp_image_detect_minutiae (img, NULL, on_detected, NULL);
+      g_main_loop_run (loop);
+
+      min = fp_image_get_minutiae (img);
+      g_snprintf (ents[n].name, sizeof (ents[n].name), "%s", argv[i]);
+      ents[n].nmin = (det_ok && min) ? (int) min->len : 0;
+      memset (&ents[n].xyt, 0, sizeof (struct xyt_struct));
+
+      if (ents[n].nmin > 0)
+        {
+          struct fp_minutiae fm;
+          fm.num = min->len;
+          fm.list = (struct fp_minutia **) min->pdata;
+          fm.alloc = min->len;
+          minutiae_to_xyt_local (&fm, W, H, &ents[n].xyt);
+        }
+      g_print ("  %-40s %3d minucias\n", argv[i], ents[n].nmin);
+      n++;
+      g_object_unref (img);
+    }
+
+  g_print ("\n=== MATRIZ DE SCORES BOZORTH3 (umbral por defecto de libfprint: 40) ===\n");
+  g_print ("      ");
+  for (j = 0; j < n; j++) g_print ("%5d", j);
+  g_print ("\n");
+  for (i = 0; i < n; i++)
+    {
+      int probe_len = 0;
+      if (ents[i].nmin > 0)
+        probe_len = bozorth_probe_init (&ents[i].xyt);
+      g_print ("  %2d: ", i);
+      for (j = 0; j < n; j++)
+        {
+          int s = 0;
+          if (i != j && ents[i].nmin > 0 && ents[j].nmin > 0)
+            s = bozorth_to_gallery (probe_len, &ents[i].xyt, &ents[j].xyt);
+          g_print ("%5d", s);
+        }
+      g_print ("   (%s)\n", ents[i].name);
+    }
+  g_print ("\nUn score >= 40 se considera coincidencia.\n");
+  return 0;
+}
-- 
